{
  "friendly_name": "Claude Code",
  "image_src": "claude.png",
  "description": "Anthropic's Claude AI assistant for terminal-based coding and development tasks",
  "cores": 2,
  "memory": 2768,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "docker_registry": "harbor.local",
  "categories": [
    "AI Tool"
  ],
  "require_gpu": false,
  "enabled": true,
  "image_type": "Container",
  "run_config": {
    "hostname": "skylus"
  },
  "exec_config": {},
  "architecture": [
    "amd64",
    "arm64"
  ],
  "launch_config": {
    "file_mapping": {
      "destination": "/tmp/launch_selections.json"
    },
    "launch_form": [
      {
        "key": "anthropic_api_key",
        "label": "Anthropic API Key",
        "value": null,
        "allow_saving": true,
        "placeholder": "sk-ant-api03-...",
        "required": false,
        "help": "Your Anthropic API key if you want to use API key authentication (Optional)",
        "input_type": "password",
        "options": [],
        "validator_regex": "^sk-ant-[a-zA-Z0-9_-]+$",
        "validator_regex_description": "API key must start with 'sk-ant-'",
        "display_if": null
      }
    ]
  },
  "compatibility": [
    {
      "version": "1.19.x",
      "image": "harbor.local/skylus-workspaces/claude-code:1.19.0",
      "uncompressed_size_mb": 1640,
      "available_tags": [
        "develop",
        "1.19.0",
        "1.19.0-rolling-weekly",
        "1.19.0-rolling-daily"
      ]
    }
  ]
}