{
  "friendly_name": "Codex CLI",
  "image_src": "codex-cli.png",
  "description": "OpenAI's GPT-powered code generation and completion tool for the terminal",
  "cores": 2,
  "memory": 2768,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "docker_registry": "harbor.local",
  "categories": [
    "AI Tool"
  ],
  "require_gpu": false,
  "enabled": true,
  "image_type": "Container",
  "run_config": {
    "hostname": "skylus"
  },
  "exec_config": {},
  "architecture": [
    "amd64",
    "arm64"
  ],
  "launch_config": {
    "file_mapping": {
      "destination": "/tmp/launch_selections.json"
    },
    "launch_form": [
      {
        "key": "openai_api_key",
        "help": "Your OpenAI API key if you want to use API key authentication (Optional)",
        "label": "OpenAI API Key",
        "value": null,
        "options": [],
        "required": false,
        "display_if": null,
        "input_type": "password",
        "placeholder": "sk-proj-...",
        "allow_saving": true,
        "validator_regex": "^sk-[a-zA-Z0-9_-]+$",
        "validator_regex_description": "API key must start with 'sk-'"
      }
    ]
  },
  "compatibility": [
    {
      "version": "1.19.x",
      "image": " harbor.local/skylus-workspaces/codex-cli:1.19.0",
      "uncompressed_size_mb": 1803,
      "available_tags": [
        "develop",
        "1.19.0",
        "1.19.0-rolling-weekly",
        "1.19.0-rolling-daily"
      ]
    }
  ]
}